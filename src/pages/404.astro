---
import Layout from '../layouts/Layout.astro';
import WavySeparator from '../components/WavySeparator.astro';
import site from '../data/site.json';
---

<Layout
  title={`Page introuvable — ${site.nom}`}
  description="Cette page n'existe pas ou plus."
  noindex
>
  <div class="container introuvable">
    <p class="kicker">Erreur 404</p>
    <h1>Cette page est introuvable.</h1>
    <WavySeparator color="coral" width={148} />
    <p class="lead">
      La page que vous cherchez n'existe pas, ou n'existe plus.
    </p>
    <p class="retours">
      <a href="/">Retour à l'accueil</a>
      <a href="/de/" hreflang="de" lang="de">Zur deutschen Seite</a>
    </p>
  </div>
</Layout>

<style>
  .introuvable {
    padding-block: clamp(4rem, 10vw, 7rem) var(--section);
    max-width: 52rem;
  }

  .introuvable .lead {
    max-width: var(--measure);
  }

  .retours {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2.25rem;
    margin-top: 2.25rem;
  }
</style>
