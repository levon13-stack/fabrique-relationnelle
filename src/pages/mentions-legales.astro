---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import WavySeparator from '../components/WavySeparator.astro';

const entry = await getEntry('pages', 'mentions-legales');
if (!entry) throw new Error('Contenu introuvable : src/content/pages/mentions-legales.md');
const { Content } = await render(entry);
const { data } = entry;
---

<Layout title={data.metaTitle} description={data.metaDescription}>
  <div class="container">
    <header class="page-head">
      <h1>{data.title}</h1>
      <WavySeparator color="brown" width={120} />
    </header>

    <article class="prose legal">
      <Content />
    </article>
  </div>
</Layout>

<style>
  .legal {
    padding-bottom: var(--section);
  }
</style>
