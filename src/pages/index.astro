---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import WavySeparator from '../components/WavySeparator.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import site from '../data/site.json';

const entry = await getEntry('pages', 'accueil');
if (!entry) throw new Error('Contenu introuvable : src/content/pages/accueil.md');
const { Content } = await render(entry);
const { data } = entry;

// Espaces insécables à l'intérieur des guillemets français.
const citation = data.citation?.replace('« ', '« ').replace(' »', ' »');
---

<Layout title={data.metaTitle} description={data.metaDescription} withJsonLd>
  <section class="hero container">
    <p class="kicker">{site.sousTitre.fr}</p>
    <h1>{data.title}</h1>
    <p class="sous-titre">{citation}</p>
    <WavySeparator color="coral" width={148} />
  </section>

  {
    data.photo && (
      <div class="ambiance container">
        <figure class="ambiance-figure">
          <PhotoSlot
            image={data.photo}
            ratio="19 / 10"
            objectPosition="center 38%"
            sizes="(min-width: 1080px) 1000px, 100vw"
            priority
          />
        </figure>
      </div>
    )
  }

  <div class="intro container">
    <div class="lead-block">
      <Content />
    </div>
  </div>

  <section class="toc-section container" aria-labelledby="toc-title">
    <h2 class="kicker" id="toc-title">{data.rubriques.sommaire}</h2>
    <ol class="toc">
      {
        data.sommaire.map((item, i) => (
          <li>
            <a href={item.href}>
              <span class="toc-num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="toc-body">
                <span class="toc-title">{item.titre}</span>
                <span class="toc-teaser">{item.teaser}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</Layout>

<style>
  /* Haut de page : kicker, titre et citation sur toute la largeur du
     contenu, puis la photo juste en dessous, puis le texte d'introduction. */
  .hero {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) 0;
  }

  /* Sous-titre : plus petit que le H1, plus grand que le corps de texte */
  .sous-titre {
    margin: 1rem 0 0;
    font-size: clamp(1.2rem, 1.05rem + 0.6vw, 1.4rem);
    font-weight: 300;
    font-style: italic;
    line-height: 1.5;
    color: var(--brown-soft);
  }

  .ambiance {
    margin-block: clamp(1.75rem, 4vw, 2.75rem) 0;
  }

  .ambiance-figure {
    margin: 0;
    border-radius: 14px;
    overflow: hidden;
  }

  .intro {
    padding-block: clamp(2.5rem, 6vw, 4rem) 0;
  }

  .toc-section {
    padding-block: clamp(3rem, 7vw, 4.5rem) var(--section);
  }

  .toc {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }

  .toc a {
    display: flex;
    gap: 1.5rem 2.5rem;
    align-items: baseline;
    padding-block: 1.35rem;
    border-top: 1px solid var(--hairline);
    text-decoration: none;
  }

  .toc li:last-child a {
    border-bottom: 1px solid var(--hairline);
  }

  .toc-num {
    font-size: 1.35rem;
    font-weight: 300;
    letter-spacing: 0.08em;
    color: var(--brown-soft);
    min-width: 2.6rem;
  }

  .toc-body {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1.75rem;
  }

  .toc-title {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--brown);
  }

  .toc-teaser {
    font-weight: 300;
    color: var(--brown-soft);
    max-width: 44ch;
  }

  .toc a:hover .toc-title,
  .toc a:hover .toc-num {
    color: var(--coral-dark);
  }

  @media (max-width: 640px) {
    .toc a {
      gap: 1rem;
    }

    .toc-num {
      min-width: 2.1rem;
      font-size: 1.1rem;
    }
  }
</style>
