---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';
import ui from '../data/ui.json';

interface Props {
  title: string;
  description: string;
  lang?: 'fr' | 'de';
  withJsonLd?: boolean;
  noindex?: boolean;
}

const { title, description, lang = 'fr', withJsonLd = false, noindex = false } = Astro.props;

const siteUrl = Astro.site!;
const path = Astro.url.pathname;
const canonical = new URL(path.endsWith('/') ? path : `${path}/`, siteUrl);
const frUrl = new URL('/', siteUrl);
const deUrl = new URL('/de/', siteUrl);
// Image de partage social (1200×630), générée par scripts/generate-og.mjs.
const ogImage = new URL('/images/og-image.png', siteUrl);
const fontsHref =
  'https://fonts.googleapis.com/css2?family=Mulish:wght@300;400;600;700&display=swap';

// Données structurées LocalBusiness / ProfessionalService (accueil + page DE),
// alimentées par src/data/site.json.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.nom,
  description: site.sousTitre[lang],
  url: siteUrl.toString(),
  image: ogImage.toString(),
  telephone: site.telephone.lien.replace('tel:', ''),
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.adresseMarseille.rue,
    postalCode: site.adresseMarseille.codePostal,
    addressLocality: site.adresseMarseille.ville,
    addressCountry: site.adresseMarseille.pays,
  },
  areaServed: site.cabinets.map((cabinet) => cabinet.nom),
  knowsLanguage: site.languesParlees,
  priceRange: site.fourchetteTarifs,
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={lang === 'fr' ? canonical : frUrl} />
    <link rel="alternate" hreflang="de" href={deUrl} />
    <link rel="alternate" hreflang="x-default" href={frUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#FAF3EA" />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href={fontsHref} />
    <link rel="stylesheet" href={fontsHref} />

    <meta property="og:site_name" content={site.nom} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'fr_FR'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {withJsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#contenu">{ui[lang].skipLink}</a>
    <Header lang={lang} />
    <main id="contenu">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
